{
  "name": "life-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev:clean": "npm run clean && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "life": "node scripts/launch.mjs",
    "life:build": "node scripts/launch.mjs --build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:baseline": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > prisma/baseline.sql",
    "db:probe": "node scripts/turso-probe.mjs",
    "db:up": "echo 'Usando SQLite. O banco de dados é inicializado com npx prisma migrate dev.'"
  },
  "dependencies": {
