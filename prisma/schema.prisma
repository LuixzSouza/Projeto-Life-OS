generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =========================================================
// MÓDULO 1: USUÁRIO E ESTATÍSTICAS
// =========================================================

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  password      String
  
  // --- CAMPO NOVO ADICIONADO ---
  role          String    @default("USER") 
  // -----------------------------

  avatarUrl     String?
  coverUrl      String?
  bio           String?
  salary        Decimal? @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relacionamentos Gerais (MANTIDOS INTACTOS)
  accounts        Account[]
  projects        Project[]
  jobApplications JobApplication[]
  accessItem      AccessItem[]
  friends         Friend[]
  wardrobe        WardrobeItem[] 
  stats           UserStats?
  settings        Settings?
  bodyMeasurements BodyMeasurement[]
  clients          Client[]
  mediaItems    MediaItem[]
}

model UserStats {
  id               String    @id @default(uuid())
  
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id])
  
  currentStreak    Int       @default(0)
  lastStudyDate    DateTime?
  dailyGoalMinutes Int       @default(60)
  
  badges           String?   
  
  updatedAt        DateTime  @updatedAt
}

// =========================================================
// MÓDULO 2: ESTUDOS (COMPATÍVEL + UPGRADE)
// =========================================================

// Tipos de Conteúdo (Novo)
model ContentType {
  id        String         @id @default(uuid())
  name      String         @unique 
  icon      String?        
  color     String?
  createdAt DateTime       @default(now())
  
  contents  StudyContent[]
}

// MANTIDO O NOME 'StudySubject' PARA NÃO QUEBRAR SEU CÓDIGO
// Mas adicionamos a hierarquia (Parent/Child) aqui dentro
model StudySubject {
  id          String   @id @default(uuid())
  title       String
  
  // --- Upgrade de Hierarquia ---
  parentId    String?  
  parent      StudySubject?   @relation("SubjectHierarchy", fields: [parentId], references: [id])
  children    StudySubject[]  @relation("SubjectHierarchy")
  
  // Metadados
  description String?
  category    String?  
  color       String?  @default("blue")
  icon        String?
  difficulty  Int      @default(3)
  status      String   @default("ACTIVE") 
  
  goalMinutes Int      @default(3600) 

  // Relacionamentos
  contents    StudyContent[]
  sessions    StudySession[] // Mantido o relacionamento com sessões
  decks       FlashcardDeck[]
  notes       StudyNote[]
  goals       LearningGoal[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Conteúdos específicos (Novo)
model StudyContent {
  id          String      @id @default(uuid())
  title       String
  
  typeId      String
  type        ContentType @relation(fields: [typeId], references: [id])
  
  url         String?     
  duration    Int?        
  author      String?     
  source      String?     
  
  isCompleted Boolean     @default(false)
  progress    Float       @default(0) 
  
  // Relacionado ao Subject
  subjectId   String
  subject     StudySubject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  notes       StudyNote[]
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// Sessões de Estudo (COMPATÍVEL)
model StudySession {
  id              String      @id @default(uuid())
  durationMinutes Int
  date            DateTime    @default(now())
  
  focusLevel      Int         @default(3) 
  notesRaw        String?     
  
  // MANTIDO 'subject' E 'subjectId' PARA O CÓDIGO ANTIGO FUNCIONAR
  subjectId       String
  subject         StudySubject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  notes           StudyNote[] 
}

// Sistema de Anotações (Novo e Conectado)
model StudyNote {
  id           String        @id @default(uuid())
  title        String
  content      String        
  summary      String?       
  
  tags         String?       
  isFavorite   Boolean       @default(false)
  
  // Conexões
  subjectId    String?
  subject      StudySubject? @relation(fields: [subjectId], references: [id])
  
  contentId    String?
  studyContent StudyContent? @relation(fields: [contentId], references: [id])
  
  sessionId    String?
  session      StudySession? @relation(fields: [sessionId], references: [id])
  
  lastReviewed DateTime?
  reviewCount  Int           @default(0)
  
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// Objetivos de Aprendizado (Novo)
model LearningGoal {
  id          String         @id @default(uuid())
  title       String
  description String?
  
  targetDate  DateTime?
  status      String         @default("IN_PROGRESS") 
  priority    Int            @default(3) 
  
  subjectId   String?
  subject     StudySubject?  @relation(fields: [subjectId], references: [id])
  
  tasks       LearningTask[]
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model LearningTask {
  id          String       @id @default(uuid())
  title       String
  isDone      Boolean      @default(false)
  orderIndex  Int          @default(0)
  
  goalId      String
  goal        LearningGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime     @default(now())
}

// =========================================================
// MÓDULO 3: FLASHCARDS (COMPATÍVEL)
// =========================================================

model FlashcardDeck {
  id             String      @id @default(uuid())
  title          String      
  description    String?     
  
  algorithm      String      @default("LEITNER") 
  isPublic       Boolean     @default(false)
  shareCode      String?     @unique
  
  masteredCount  Int         @default(0)
  
  // MANTIDO relacionamento com Subject
  studySubjectId String?
  studySubject   StudySubject? @relation(fields: [studySubjectId], references: [id])

  cards          Flashcard[]

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Flashcard {
  id           String        @id @default(uuid())
  term         String        
  definition   String        
  imageUrl     String?       
  
  box          Int           @default(1) 
  easeFactor   Float         @default(2.5) 
  interval     Int           @default(0)   
  
  nextReview   DateTime?     
  lastReviewed DateTime?     
  reviewCount  Int           @default(0)

  deckId       String
  deck         FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  createdAt    DateTime      @default(now())
}

// =========================================================
// MÓDULO 4: FINANCEIRO
// =========================================================

model Account {
  id           String        @id @default(uuid())
  name         String
  type         String
  balance      Decimal       @default(0.00)
  color        String?       @default("#000000")

  isConnected  Boolean       @default(false)
  provider     String?       
  externalId   String?       

  transactions Transaction[]

  userId       String?
  user         User?         @relation(fields: [userId], references: [id])

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Transaction {
  id          String   @id @default(uuid())
  description String
  amount      Decimal
  type        String   
  category    String
  date        DateTime @default(now())

  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])

  createdAt   DateTime @default(now())
}

model RecurringExpense {
  id         String   @id @default(uuid())
  title      String
  amount     Decimal
  dayOfMonth Int
  category   String
  active     Boolean  @default(true)

  createdAt  DateTime @default(now())
}

model WishlistItem {
  id         String   @id @default(uuid())
  name       String
  price      Decimal
  saved      Decimal  @default(0.00)
  priority   String   @default("MEDIUM")

  imageUrl   String?  
  productUrl String?  

  status     String   @default("SAVING")

  createdAt  DateTime @default(now())
}

// =========================================================
// MÓDULO 5: PROJETOS & TAREFAS
// =========================================================

model Project {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  color       String?  @default("#6366f1")

  userId      String?
  user        User?    @relation(fields: [userId], references: [id])

  tasks       Task[]
  events      Event[]

  clientId     String?
  client       Client?   @relation(fields: [clientId], references: [id])
}


model Task {
  id            String   @id @default(cuid())
  title         String
  description   String?
  isDone        Boolean  @default(false)
  priority      String   @default("LOW") // HIGH, MEDIUM, LOW
  status        String   @default("TODO") // TODO, IN_PROGRESS, REVIEW, DONE
  dueDate       DateTime?
  image         String?
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id])
  isPinned      Boolean  @default(false)
  isStarred     Boolean  @default(false)
  progress      Int      @default(0)
  estimatedTime Int?     // em minutos
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  order       Float    @default(0)
}

// =========================================================
// MÓDULO 6: JOB TRACKER
// =========================================================

model JobApplication {
  id           String   @id @default(uuid())
  company      String
  role         String
  status       String
  jobUrl       String?
  salary       String?
  location     String?
  requirements String?  

  type         String   @default("JOB")

  appliedDate  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
}

// =========================================================
// MÓDULO 7: SAÚDE & CORPO
// =========================================================

model Workout {
  id          String   @id @default(uuid())
  title       String
  type        String

  duration    Int
  intensity   String
  feeling     String?
  notes       String?  

  distance    Float?
  pace        String?

  muscleGroup String?
  exercises   String?  

  date        DateTime @default(now())
}

model HealthMetric {
  id    String   @id @default(uuid())
  type  String
  value Float
  date  DateTime @default(now())
}

model BodyMeasurement {
  id        String   @id @default(uuid())
  date      DateTime @default(now())

  weight    Float
  height    Float
  gender    String   
  activity  Float    @default(1.2) 
  birthDate DateTime?

  neck      Float?
  waist     Float?
  hip       Float?
  
  shoulders Float?
  chest     Float?
  armLeft   Float?
  armRight  Float?
  forearmLeft  Float?
  forearmRight Float?

  thighLeft    Float?
  thighRight   Float?
  calfLeft     Float?
  calfRight    Float?

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade) 

  @@index([date])
}

model Meal {
  id       String   @id @default(uuid())
  title    String
  items    String
  calories Int?
  type     String
  date     DateTime @default(now())
}

// Modelo para o Planejador Semanal
model MealPlan {
  id          String   @id @default(cuid())
  userId      String
  dayOfWeek   Int      // 0 = Domingo, 1 = Segunda, ..., 6 = Sábado
  mealType    String   // "BREAKFAST", "LUNCH", "SNACK", "DINNER"
  title       String   // Ex: "Café da Manhã Forte"
  items       String   // Ex: "Ovos, Aveia, Banana"
  calories    Int?     // Estimativa
  isCompleted Boolean  @default(false) // Para checkar se seguiu o plano
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, dayOfWeek])
}

// =========================================================
// MÓDULO 8: AGENDA & ROTINA
// =========================================================

model Event {
  id          String    @id @default(uuid())
  title       String
  startTime   DateTime
  endTime     DateTime?
  isAllDay    Boolean   @default(false)
  description String?
  category    String    @default("general")

  location    String?
  color       String?   @default("#6366f1")
  emailAlert  Boolean   @default(true)

  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])

  createdAt   DateTime  @default(now())
}

model RoutineItem {
  id          String   @id @default(uuid())
  title       String
  startTime   String
  endTime     String
  description String?  
  category    String

  daysOfWeek  String

  createdAt   DateTime @default(now())
}

// =========================================================
// MÓDULO 9: CONFIGURAÇÕES & SISTEMA
// =========================================================

model Settings {
  id                String   @id @default(uuid())
  theme             String   @default("system")
  accentColor       String   @default("zinc")
  language          String   @default("pt-BR")
  currency          String   @default("BRL")
  
  // Horários de trabalho
  workStart         String   @default("09:00")
  workEnd           String   @default("18:00")

  // Inteligência Artificial
  aiProvider        String   @default("ollama")
  aiModel           String   @default("llama3")
  aiPersona         String?
  aiUsage           String?  // Dica: use Json para estatísticas complexas se preferir
  
  // Chaves de API (Removido @map para simplificar e evitar confusão no código)
  openaiKey         String?
  groqKey           String?
  googleKey         String?
  tmdbApiKey        String?
  rawgApiKey        String?
  pluggyClientId    String?
  pluggySecret      String?

  // Localização de dados (Cuidado com caminhos absolutos como D:/ se for rodar em Linux/Docker)
  storagePath       String?  @default("D:/LifeOS_Data")

  // Metadados e Segurança
  updatedAt         DateTime @updatedAt
  onboardingCompleted Boolean  @default(false)
  autoLockMinutes   Int      @default(15)
  privacyMode       Boolean  @default(false)

  // Relacionamento (Tornado obrigatório para garantir integridade)
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =========================================================
// MÓDULO 10: CMS & OUTROS
// =========================================================

model ManagedSite {
  id        String    @id @default(uuid())
  name      String
  url       String?
  apiKey    String    @unique @default(uuid())
  createdAt DateTime  @default(now())

  pages     SitePage[]
}

model SitePage {
  id        String      @id @default(uuid())
  slug      String
  content   String      
  siteId    String
  site      ManagedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  updatedAt DateTime    @updatedAt
}

model AiChat {
  id        String      @id @default(uuid())
  title     String      @default("Nova Conversa")
  createdAt DateTime    @default(now())
  messages  AiMessage[]
}

model AiMessage {
  id        String   @id @default(uuid())
  role      String
  content   String   
  provider  String?  
  model     String?  
  chatId    String
  chat      AiChat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model AccessItem {
  id        String   @id @default(uuid())
  title     String
  username  String?
  password  String
  url       String?
  category  String
  notes     String?  
  client    String?  @map("client_name")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SavedLink {
  id          String   @id @default(uuid())
  title       String
  url         String
  description String?  
  imageUrl    String?  
  category    String?  
  isFavorite  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MediaItem {
  id          String   @id @default(uuid())
  userId      String?  
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- Identificação Básica ---
  title       String
  type        String   
  status      String   @default("PLAN_TO_WATCH") 
  
  // --- Metadados ---
  overview    String?  @map("subtitle") // 🟢 SALVA-VIDAS: Preserva seus subtítulos!
  coverUrl    String?  
  genres      String?  @map("category") // 🟢 SALVA-VIDAS: Preserva suas categorias!
  creator     String?  
  releaseYear String?  
  externalId  String?  
  
  // --- Interação Pessoal ---
  rating      Int      @default(0) 
  notes       String?  

  // --- Sistema ---
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Friend {
  id        String    @id @default(cuid())
  name      String
  nickname  String?   
  email     String?
  phone     String?   
  tags      String?
  birthday  DateTime?
  instagram String?
  linkedin  String?
  twitter   String?
  jobTitle  String?   
  company   String?   
  proximity String    @default("CASUAL") 
  pixKey    String?   
  address   String?   
  notes     String?   
  imageUrl  String?   
  giftIdeas String?   
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model WardrobeItem {
  id         String   @id @default(uuid())
  name       String   
  imageUrl   String?  
  brand      String?  
  color      String?  
  size       String?  
  category   String   
  season     String?  
  price      Decimal? 
  wearCount  Int      @default(0) 
  lastWorn   DateTime? 
  isFavorite Boolean  @default(false)
  status     String   @default("IN_CLOSET") 
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// =========================================================
// MÓDULO 11: NEGÓCIOS & CLIENTES (NOVO)
// =========================================================

model Client {
  id        String   @id @default(uuid())
  name      String   // Nome do contato ou da empresa
  company   String?  // Nome Fantasia (opcional)
  phone     String?  // Para o botão de WhatsApp
  email     String?  
  document  String?  // CPF ou CNPJ
  address   String?
  notes     String?
  
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE, LEAD
  
  // Relacionamentos
  userId    String?  // Opcional para não quebrar seeders antigos, mas ideal vincular
  user      User?    @relation(fields: [userId], references: [id])
  
  projects  Project[] // Projetos vinculados a este cliente
  billings  Billing[] // Contratos/Cobranças gerais
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// O "Contrato" ou "Acordo". Ex: "Criação de Site" ou "Manutenção Mensal"
model Billing {
  id          String   @id @default(uuid())
  title       String   // Ex: "Desenvolvimento E-commerce"
  description String?
  
  totalValue  Decimal  // Valor total do acordo
  
  // Configuração de Pagamento
  type        String   @default("ONE_OFF") // ONE_OFF (Parcelado ou à vista) ou RECURRING (Mensalidade)
  installments Int     @default(1)         // Número de parcelas (se for ONE_OFF)
  
  billingDay  Int?     // Dia de vencimento preferencial (ex: dia 10)
  startDate   DateTime @default(now()) // Quando começa a valer
  
  status      String   @default("ACTIVE") // ACTIVE, COMPLETED, CANCELED
  
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  invoices    Invoice[] // As faturas geradas (parcelas)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A "Fatura" ou "Parcela" específica. Ex: "Parcela 1/3"
model Invoice {
  id          String   @id @default(uuid())
  title       String   // Ex: "Parcela 1/3" ou "Mensalidade Janeiro"
  value       Decimal  // Valor desta fatura específica
  dueDate     DateTime // Data de Vencimento
  
  status      String   @default("PENDING") // PENDING, PAID, OVERDUE, CANCELED
  paidAt      DateTime? // Data do pagamento (para fluxo de caixa)
  
  billingId   String
  billing     Billing  @relation(fields: [billingId], references: [id], onDelete: Cascade)
  
  linkUrl     String?   // Link do boleto ou comprovante se houver
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BackupLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  fileName  String
  path      String
  size      String   // Ex: "2.5 MB"
  type      String   // "MANUAL" | "AUTO"
}