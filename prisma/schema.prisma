generator client {
  provider        = "prisma-client-js"
  // driverAdapters: permite conectar via @prisma/adapter-libsql (Turso/cloud)
  // mantendo o provider "sqlite" — local (arquivo) e nuvem usam o MESMO schema.
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =========================================================
// MÓDULO 1: USUÁRIO E ESTATÍSTICAS
// =========================================================

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  // --- CAMPO NOVO ADICIONADO ---
  role String @default("USER")
  // -----------------------------

  avatarUrl String?
  coverUrl  String?
  bio       String?
  salary    Decimal? @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos Gerais (MANTIDOS INTACTOS)
  accounts         Account[]
  projects         Project[]
  jobApplications  JobApplication[]
  accessItem       AccessItem[]
  friends          Friend[]
  wardrobe         WardrobeItem[]
  stats            UserStats?
  settings         Settings?
  portfolio        Portfolio?
  bodyMeasurements BodyMeasurement[]
  clients          Client[]
  mediaItems       MediaItem[]

  // --- Multi-user: relações adicionadas na migração de isolamento ---
  transactions      Transaction[]
  recurringExpenses RecurringExpense[]
  wishlistItems     WishlistItem[]
  tasks             Task[]
  workouts          Workout[]
  healthMetrics     HealthMetric[]
  meals             Meal[]
  mealPlans         MealPlan[]
  events            Event[]
  routineItems      RoutineItem[]
  studySubjects     StudySubject[]
  studySessions     StudySession[]
  studyNotes        StudyNote[]
  studyContents     StudyContent[]
  learningGoals     LearningGoal[]
  learningTasks     LearningTask[]
  flashcardDecks    FlashcardDeck[]
  flashcards        Flashcard[]
  managedSites      ManagedSite[]
  sitePages         SitePage[]
  meetings          Meeting[]
  aiChats           AiChat[]
  aiMessages        AiMessage[]
  savedLinks        SavedLink[]
  billings          Billing[]
  invoices          Invoice[]
  backupLogs        BackupLog[]
  challenges        Challenge[]
  challengeCheckins ChallengeCheckin[]
  investmentHoldings InvestmentHolding[]

  // --- Tecido conectivo central (cross-módulo) ---
  tags          Tag[]
  taggables     Taggable[]
  categories    Category[]
  notifications Notification[]
  activityLogs  ActivityLog[]
  attachments   Attachment[]
  entityLinks   EntityLink[]
}

model UserStats {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  currentStreak    Int       @default(0)
  lastStudyDate    DateTime?
  dailyGoalMinutes Int       @default(60)

  badges String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// MÓDULO 2: ESTUDOS (COMPATÍVEL + UPGRADE)
// =========================================================

// Tipos de Conteúdo (Novo) — taxonomia global (sem dono).
model ContentType {
  id        String   @id @default(uuid())
  name      String   @unique
  icon      String?
  color     String?
  createdAt DateTime @default(now())

  contents StudyContent[]
}

// MANTIDO O NOME 'StudySubject' PARA NÃO QUEBRAR SEU CÓDIGO
// Mas adicionamos a hierarquia (Parent/Child) aqui dentro
model StudySubject {
  id    String @id @default(uuid())
  title String

  // --- Upgrade de Hierarquia ---
  parentId String?
  parent   StudySubject?  @relation("SubjectHierarchy", fields: [parentId], references: [id])
  children StudySubject[] @relation("SubjectHierarchy")

  // Metadados
  description String?
  category    String?
  color       String? @default("blue")
  icon        String?
  difficulty  Int     @default(3)
  status      String  @default("ACTIVE")

  goalMinutes Int @default(3600)

  // Relacionamentos
  contents StudyContent[]
  sessions StudySession[] // Mantido o relacionamento com sessões
  decks    FlashcardDeck[]
  notes    StudyNote[]
  goals    LearningGoal[]

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([parentId])
}

// Conteúdos específicos (Novo)
model StudyContent {
  id    String @id @default(uuid())
  title String

  typeId String
  type   ContentType @relation(fields: [typeId], references: [id])

  url      String?
  duration Int?
  author   String?
  source   String?

  isCompleted Boolean @default(false)
  progress    Float   @default(0)

  // Relacionado ao Subject
  subjectId String
  subject   StudySubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  notes StudyNote[]

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([subjectId])
  @@index([typeId])
}

// Sessões de Estudo (COMPATÍVEL)
model StudySession {
  id              String   @id @default(uuid())
  durationMinutes Int
  date            DateTime @default(now())

  focusLevel Int     @default(3)
  notesRaw   String?

  // MANTIDO 'subject' E 'subjectId' PARA O CÓDIGO ANTIGO FUNCIONAR
  subjectId String
  subject   StudySubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  notes StudyNote[]

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([subjectId])
  @@index([userId, date])
}

// Sistema de Anotações (Novo e Conectado)
model StudyNote {
  id      String  @id @default(uuid())
  title   String
  content String
  summary String?

  tags       String?
  isFavorite Boolean @default(false)

  // Conexões
  subjectId String?
  subject   StudySubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  contentId    String?
  studyContent StudyContent? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  sessionId String?
  session   StudySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  lastReviewed DateTime?
  reviewCount  Int       @default(0)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([subjectId])
}

// Objetivos de Aprendizado (Novo)
model LearningGoal {
  id          String  @id @default(uuid())
  title       String
  description String?

  targetDate DateTime?
  status     String    @default("IN_PROGRESS")
  priority   Int       @default(3)

  subjectId String?
  subject   StudySubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  tasks LearningTask[]

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([subjectId])
}

model LearningTask {
  id         String  @id @default(uuid())
  title      String
  isDone     Boolean @default(false)
  orderIndex Int     @default(0)

  goalId String
  goal   LearningGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([goalId])
}

// =========================================================
// MÓDULO 3: FLASHCARDS (COMPATÍVEL)
// =========================================================

model FlashcardDeck {
  id          String  @id @default(uuid())
  title       String
  description String?

  algorithm String  @default("LEITNER")
  isPublic  Boolean @default(false)
  shareCode String? @unique

  masteredCount Int @default(0)

  // MANTIDO relacionamento com Subject
  studySubjectId String?
  studySubject   StudySubject? @relation(fields: [studySubjectId], references: [id], onDelete: SetNull)

  cards Flashcard[]

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([studySubjectId])
}

model Flashcard {
  id         String  @id @default(uuid())
  term       String
  definition String
  imageUrl   String?

  box        Int   @default(1)
  easeFactor Float @default(2.5)
  interval   Int   @default(0)

  nextReview   DateTime?
  lastReviewed DateTime?
  reviewCount  Int       @default(0)

  deckId String
  deck   FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([deckId])
  @@index([userId, nextReview])
}

// =========================================================
// MÓDULO 4: FINANCEIRO
// =========================================================

model Account {
  id      String  @id @default(uuid())
  name    String
  type    String
  balance Decimal @default(0.00)
  color   String? @default("#000000")

  isConnected Boolean @default(false)
  provider    String?
  externalId  String?

  transactions Transaction[]

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Transaction {
  id          String   @id @default(uuid())
  description String
  amount      Decimal
  type        String
  category    String // rótulo legado (texto livre) — mantido p/ compatibilidade
  date        DateTime @default(now())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Categoria normalizada (nova) — opcional, convive com o rótulo legado.
  categoryId  String?
  categoryRef Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Fatura de Negócios que originou este lançamento (quando aplicável)
  invoice Invoice?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([accountId])
  @@index([categoryId])
  @@index([userId, date])
}

model RecurringExpense {
  id         String  @id @default(uuid())
  title      String
  amount     Decimal
  dayOfMonth Int
  category   String // rótulo legado
  active     Boolean @default(true)

  categoryId  String?
  categoryRef Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([categoryId])
}

model WishlistItem {
  id       String  @id @default(uuid())
  name     String
  price    Decimal
  saved    Decimal @default(0.00)
  priority String  @default("MEDIUM")

  imageUrl   String?
  productUrl String?

  status String @default("SAVING")

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// =========================================================
// MÓDULO 4.1: CATEGORIAS DE FINANÇAS (NOVO — orçamento/cor/ícone)
// =========================================================

model Category {
  id    String  @id @default(uuid())
  name  String
  type  String  @default("EXPENSE") // INCOME | EXPENSE
  color String? @default("#6366f1")
  icon  String?

  monthlyBudget Decimal? // teto mensal opcional (orçamento)

  // Subcategorias (hierarquia)
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  transactions      Transaction[]
  recurringExpenses RecurringExpense[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name, type])
  @@index([userId])
  @@index([parentId])
}

// =========================================================
// MÓDULO 5: PROJETOS & TAREFAS
// =========================================================

model Project {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  color       String?  @default("#6366f1")

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks    Task[]
  events   Event[]
  meetings Meeting[]

  jobApplications JobApplication[]

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  deletedAt DateTime?

  @@index([userId])
  @@index([clientId])
}

// Reunião: notas rápidas + resumo gerado por IA (vira checklist/tarefas).
model Meeting {
  id       String  @id @default(uuid())
  title    String
  rawNotes String  @default("")
  summary  String?
  image    String? // legado: 1ª imagem (compat). Galeria completa fica em `images`.
  images   String? // JSON: array de data URLs (anexos da reunião)

  participants String? // JSON: array de nomes dos participantes
  tags         String? // JSON: array de etiquetas
  decisions    String? // JSON: array de decisões destacadas

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([projectId])
}

model Task {
  id            String    @id @default(cuid())
  title         String
  description   String?
  isDone        Boolean   @default(false)
  priority      String    @default("LOW") // HIGH, MEDIUM, LOW
  status        String    @default("TODO") // TODO, IN_PROGRESS, REVIEW, DONE
  dueDate       DateTime?
  image         String?
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  isPinned      Boolean   @default(false)
  isStarred     Boolean   @default(false)
  progress      Int       @default(0)
  estimatedTime Int? // em minutos
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  order         Float     @default(0)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deletedAt DateTime?

  @@index([userId])
  @@index([projectId])
  @@index([userId, isDone])
}

// =========================================================
// MÓDULO 6: JOB TRACKER
// =========================================================

model JobApplication {
  id           String  @id @default(uuid())
  company      String
  role         String
  status       String
  jobUrl       String?
  salary       String?
  location     String?
  requirements String?

  // --- Campos profissionais (gestão de candidaturas) ---
  contactName  String?
  contactEmail String?
  followUpDate DateTime?
  priority     String?

  type String @default("JOB")

  appliedDate DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // --- Conexão com o módulo de Projetos ---
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
}

// =========================================================
// MÓDULO 6.1: CURRÍCULO / PORTFÓLIO (Builder Engine)
// =========================================================

model Portfolio {
  id        String   @id @default(uuid())
  // JSON serializado de PortfolioData (SQLite armazena como String para portabilidade total).
  data      String
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Posição da carteira de investimentos do usuário (ações, FIIs, ETFs, cripto).
// O preço atual é buscado ao vivo via brapi/AwesomeAPI; aqui guardamos só
// quantidade e preço médio de compra (cost basis).
model InvestmentHolding {
  id        String   @id @default(uuid())
  ticker    String // ex.: PETR4, MXRF11, IVVB11, BTC
  type      String   @default("STOCK") // STOCK | FII | ETF | CRYPTO
  quantity  Decimal
  avgPrice  Decimal // preço médio de compra (custo)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =========================================================
// MÓDULO 7.1: DESAFIOS & PROGRAMAS DE TREINO
// =========================================================

model Challenge {
  id           String   @id @default(uuid())
  title        String
  description  String?
  category     String? // STRENGTH | CARDIO | MOBILITY | HABIT
  durationDays Int      @default(30)
  startDate    DateTime @default(now())
  color        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  userId   String
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkins ChallengeCheckin[]

  @@index([userId])
}

model ChallengeCheckin {
  id       String   @id @default(uuid())
  dayIndex Int // dia 0..durationDays-1
  date     DateTime @default(now())
  note     String?

  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, dayIndex])
  @@index([userId])
}

// =========================================================
// MÓDULO 7: SAÚDE & CORPO
// =========================================================

model Workout {
  id    String @id @default(uuid())
  title String
  type  String

  duration  Int
  intensity String
  feeling   String?
  notes     String?

  distance Float?
  pace     String?

  muscleGroup String?
  exercises   String?

  // --- Importação externa (GPX/TCX/CSV) ---
  source     String? // Ex: "MANUAL", "STRAVA_CSV", "GPX", "TCX"
  externalId String? // ID original do arquivo para deduplicação

  date DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
}

model HealthMetric {
  id    String   @id @default(uuid())
  type  String
  value Float
  date  DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type, date])
}

model BodyMeasurement {
  id   String   @id @default(uuid())
  date DateTime @default(now())

  weight    Float
  height    Float
  gender    String
  activity  Float     @default(1.2)
  birthDate DateTime?

  neck  Float?
  waist Float?
  hip   Float?

  shoulders    Float?
  chest        Float?
  armLeft      Float?
  armRight     Float?
  forearmLeft  Float?
  forearmRight Float?

  thighLeft  Float?
  thighRight Float?
  calfLeft   Float?
  calfRight  Float?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
}

model Meal {
  id       String   @id @default(uuid())
  title    String
  items    String
  calories Int?
  type     String
  date     DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
}

// Modelo para o Planejador Semanal
model MealPlan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek   Int // 0 = Domingo, 1 = Segunda, ..., 6 = Sábado
  mealType    String // "BREAKFAST", "LUNCH", "SNACK", "DINNER"
  title       String // Ex: "Café da Manhã Forte"
  items       String // Ex: "Ovos, Aveia, Banana"
  calories    Int? // Estimativa
  isCompleted Boolean  @default(false) // Para checkar se seguiu o plano
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, dayOfWeek])
}

// =========================================================
// MÓDULO 8: AGENDA & ROTINA
// =========================================================

model Event {
  id          String    @id @default(uuid())
  title       String
  startTime   DateTime
  endTime     DateTime?
  isAllDay    Boolean   @default(false)
  description String?
  category    String    @default("general")

  location   String?
  color      String? @default("#6366f1")
  emailAlert Boolean @default(true)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([projectId])
  @@index([userId, startTime])
}

model RoutineItem {
  id          String  @id @default(uuid())
  title       String
  startTime   String
  endTime     String
  description String?
  category    String

  daysOfWeek String

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

// =========================================================
// MÓDULO 9: CONFIGURAÇÕES & SISTEMA
// =========================================================

model Settings {
  id          String @id @default(uuid())
  theme       String @default("system")
  accentColor String @default("zinc")
  language    String @default("pt-BR")
  currency    String @default("BRL")

  // Horários de trabalho
  workStart String @default("09:00")
  workEnd   String @default("18:00")

  // Cobrança / Negócios (usado nas mensagens de cobrança do módulo Business)
  pixKey       String?
  businessName String?

  // Inteligência Artificial
  aiProvider String  @default("ollama")
  aiModel    String  @default("llama3")
  aiPersona  String?
  aiUsage    String? // Dica: use Json para estatísticas complexas se preferir

  // Chaves de API (Removido @map para simplificar e evitar confusão no código)
  openaiKey         String?
  groqKey           String?
  googleKey         String?
  deepseekKey       String?
  mistralKey        String?
  tmdbApiKey        String?
  rawgApiKey        String?
  googleBooksApiKey String?
  pluggyClientId    String?
  pluggySecret      String?
  brapiToken        String? // brapi.dev — cotações da B3 (ações/FIIs/ETFs). Token grátis.
  marketWatchlist   String? // JSON: tickers favoritados no Terminal de Mercado

  // Nutrição: busca online de alimentos (Open Food Facts — gratuita, sem chave)
  foodApiEnabled Boolean @default(true)

  // Metas de saúde (centralizadas no perfil — sincronizam entre dispositivos)
  sleepGoalHours      Float? // meta de sono em horas/noite (ex.: 8). null = padrão do sistema
  calorieGoalOverride Int?   // override manual da meta calórica diária. null = usar sugestão do perfil (TDEE)

  // Localização de dados (Cuidado com caminhos absolutos como D:/ se for rodar em Linux/Docker)
  storagePath String? @default("D:/LifeOS_Data")

  // Metadados e Segurança
  updatedAt           DateTime @updatedAt
  onboardingCompleted Boolean  @default(false)
  autoLockMinutes     Int      @default(15)
  privacyMode         Boolean  @default(false)

  // Relacionamento (Tornado obrigatório para garantir integridade)
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =========================================================
// MÓDULO 10: CMS & OUTROS
// =========================================================

model ManagedSite {
  id        String   @id @default(uuid())
  name      String
  url       String?
  apiKey    String   @unique @default(uuid())
  createdAt DateTime @default(now())

  pages SitePage[]

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SitePage {
  id        String      @id @default(uuid())
  slug      String
  content   String
  siteId    String
  site      ManagedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  updatedAt DateTime    @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([siteId])
}

model AiChat {
  id        String      @id @default(uuid())
  title     String      @default("Nova Conversa")
  createdAt DateTime    @default(now())
  messages  AiMessage[]

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AiMessage {
  id        String   @id @default(uuid())
  role      String
  content   String
  provider  String?
  model     String?
  chatId    String
  chat      AiChat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([chatId])
}

model AccessItem {
  id        String   @id @default(uuid())
  title     String
  username  String?
  password  String
  url       String?
  category  String
  notes     String?
  client    String?  @map("client_name")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model SavedLink {
  id          String  @id @default(uuid())
  title       String
  url         String
  description String?
  imageUrl    String?
  category    String?
  isFavorite  Boolean @default(false)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

model MediaItem {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- Identificação Básica ---
  title  String
  type   String
  status String @default("PLAN_TO_WATCH")

  // --- Metadados ---
  overview    String? @map("subtitle") // 🟢 SALVA-VIDAS: Preserva seus subtítulos!
  coverUrl    String?
  genres      String? @map("category") // 🟢 SALVA-VIDAS: Preserva suas categorias!
  creator     String?
  releaseYear String?
  externalId  String?

  // --- Interação Pessoal ---
  rating Int     @default(0)
  notes  String?

  // --- Sistema ---
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([userId, status])
}

model Friend {
  id        String    @id @default(cuid())
  name      String
  nickname  String?
  email     String?
  phone     String?
  tags      String?
  birthday  DateTime?
  instagram String?
  linkedin  String?
  twitter   String?
  jobTitle  String?
  company   String?
  proximity String    @default("CASUAL")
  pixKey    String?
  address   String?
  notes     String?
  imageUrl  String?
  giftIdeas String?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clients   Client[] // Clientes (Negócios) que apontam para esta conexão
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

model WardrobeItem {
  id         String    @id @default(uuid())
  name       String
  imageUrl   String?
  brand      String?
  color      String?
  size       String?
  category   String
  season     String?
  price      Decimal?
  wearCount  Int       @default(0)
  lastWorn   DateTime?
  isFavorite Boolean   @default(false)
  status     String    @default("IN_CLOSET")
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
}

// =========================================================
// MÓDULO 11: NEGÓCIOS & CLIENTES (NOVO)
// =========================================================

model Client {
  id       String  @id @default(uuid())
  name     String // Nome do contato ou da empresa
  company  String? // Nome Fantasia (opcional)
  imageUrl String? // Logo/foto da empresa (Base64 ou URL)
  website  String? // Site da empresa
  phone    String? // Para o botão de WhatsApp
  email    String?
  document String? // CPF ou CNPJ
  address  String?
  notes    String?

  status String @default("ACTIVE") // ACTIVE, INACTIVE, LEAD

  // Vínculo opcional com uma Conexão (pessoa de contato do cliente)
  friendId String?
  friend   Friend? @relation(fields: [friendId], references: [id], onDelete: SetNull)

  // Relacionamentos
  userId String? // Opcional para não quebrar seeders antigos, mas ideal vincular
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projects Project[] // Projetos vinculados a este cliente
  billings Billing[] // Contratos/Cobranças gerais

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([friendId])
}

// O "Contrato" ou "Acordo". Ex: "Criação de Site" ou "Manutenção Mensal"
model Billing {
  id          String  @id @default(uuid())
  title       String // Ex: "Desenvolvimento E-commerce"
  description String?

  totalValue Decimal // Valor total do acordo

  // Configuração de Pagamento
  type         String @default("ONE_OFF") // ONE_OFF (Parcelado ou à vista) ou RECURRING (Mensalidade)
  installments Int    @default(1) // Número de parcelas (se for ONE_OFF)

  billingDay Int? // Dia de vencimento preferencial (ex: dia 10)
  startDate  DateTime @default(now()) // Quando começa a valer

  lastRemindedAt DateTime? // Última vez que uma cobrança foi enviada (Central de Cobranças)

  status String @default("ACTIVE") // ACTIVE, COMPLETED, CANCELED

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  invoices Invoice[] // As faturas geradas (parcelas)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([clientId])
}

// A "Fatura" ou "Parcela" específica. Ex: "Parcela 1/3"
model Invoice {
  id      String   @id @default(uuid())
  title   String // Ex: "Parcela 1/3" ou "Mensalidade Janeiro"
  value   Decimal // Valor desta fatura específica
  dueDate DateTime // Data de Vencimento

  status String    @default("PENDING") // PENDING, PAID, OVERDUE, CANCELED
  paidAt DateTime? // Data do pagamento (para fluxo de caixa)

  billingId String
  billing   Billing @relation(fields: [billingId], references: [id], onDelete: Cascade)

  linkUrl String? // Link do boleto ou comprovante se houver

  // Lançamento financeiro gerado quando a fatura é recebida (evita duplicidade e permite estorno)
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([billingId])
  @@index([status])
  @@index([dueDate])
}

model BackupLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  fileName  String
  path      String
  size      String // Ex: "2.5 MB"
  type      String // "MANUAL" | "AUTO"

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =========================================================
// MÓDULO 12: TECIDO CONECTIVO CENTRAL (cross-módulo, escalável)
// =========================================================

// Tag universal — vocabulário compartilhado entre todos os módulos.
model Tag {
  id    String  @id @default(uuid())
  name  String
  color String? @default("#6366f1")
  icon  String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taggables Taggable[]

  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@index([userId])
}

// Ligação polimórfica Tag <-> qualquer entidade (entityType + entityId).
// Ex.: ("task", "<id>"), ("note", "<id>"), ("transaction", "<id>")...
model Taggable {
  id String @id @default(uuid())

  tagId String
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  entityType String
  entityId   String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tagId, entityType, entityId])
  @@index([entityType, entityId])
  @@index([userId])
}

// Notificação / Lembrete central — qualquer módulo enfileira aqui.
model Notification {
  id    String  @id @default(uuid())
  type  String // INVOICE_DUE | EVENT | BIRTHDAY | FLASHCARD_REVIEW | CHALLENGE | TASK_DUE | SYSTEM
  title String
  body  String?

  // Referência leve à entidade de origem (sem FK rígida = flexível p/ qualquer módulo).
  entityType String?
  entityId   String?
  actionUrl  String?

  priority String    @default("NORMAL") // LOW | NORMAL | HIGH
  dueAt    DateTime?
  readAt   DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, dueAt])
}

// Log de atividades (auditoria / linha do tempo entre módulos).
model ActivityLog {
  id      String  @id @default(uuid())
  action  String // CREATE | UPDATE | DELETE | COMPLETE | LOGIN | ...
  module  String // finance | tasks | studies | health | ...
  summary String?

  entityType String?
  entityId   String?
  meta       String? // JSON serializado (detalhes)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

// Anexo polimórfico — arquivos/imagens num lugar só (em vez de base64 inline).
model Attachment {
  id   String  @id @default(uuid())
  name String?
  kind String  @default("IMAGE") // IMAGE | FILE | LINK

  // Conteúdo: URL externa OU base64 (portável). Um dos dois.
  url       String?
  blob      String?
  mimeType  String?
  sizeBytes Int?

  entityType String
  entityId   String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
}

// Relacionamento genérico entre quaisquer entidades (grafo flexível).
// Ex.: liga uma Transaction a um Project, uma Task a um LearningGoal, etc.
model EntityLink {
  id String @id @default(uuid())

  fromType String
  fromId   String
  toType   String
  toId     String
  kind     String @default("RELATED") // RELATED | BLOCKS | DERIVED_FROM | REFERENCES

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([fromType, fromId, toType, toId, kind])
  @@index([fromType, fromId])
  @@index([toType, toId])
  @@index([userId])
}
