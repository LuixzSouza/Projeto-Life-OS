# ============================================================================
# Life OS — Exemplo de variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores.
#   cp .env.example .env   (Linux/macOS)   |   copy .env.example .env  (Windows)
# O arquivo `.env` é ignorado pelo git (.gitignore) — nunca commite segredos.
# ============================================================================

# --- BANCO DE DADOS (obrigatório) ---
# SQLite local (padrão, portátil). Aponte para onde o arquivo .db deve viver.
# Windows: use barras normais. Ex: "file:C:/LifeOS_Data/life_os.db"
DATABASE_URL="file:./prisma/life_os.db"
# Alternativa MySQL (opcional):
# DATABASE_URL="mysql://usuario:senha@localhost:3306/life_os"

# --- SEGURANÇA ---
# Segredo de assinatura dos JWT de sessão. Use um valor longo e aleatório.
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Opcional no modo desktop/local: se ausente, o app gera e persiste um segredo
# forte automaticamente em `life-os-config.json` na 1ª execução.
# Em deploy de servidor (Vercel etc.) defina explicitamente para sessões estáveis.
JWT_SECRET="sua_chave_secreta_aqui"
# Chave de criptografia do Cofre de Acessos (mesma regra do JWT_SECRET).
ENCRYPTION_KEY="sua_chave_de_criptografia_aqui"

# ============================================================================
# INTEGRAÇÕES (opcionais — também podem ser configuradas pela UI em Settings)
# ============================================================================

# Filmes/Séries -> https://www.themoviedb.org/settings/api
TMDB_API_KEY=""

# Jogos -> https://rawg.io/apidocs
RAWG_API_KEY=""

# Open Banking -> https://www.pluggy.ai
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""

# --- Inteligência Artificial (opcionais) ---
# OpenAI -> https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# Groq -> https://console.groq.com/keys
GROQ_API_KEY=""
# Google Gemini -> https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=""
