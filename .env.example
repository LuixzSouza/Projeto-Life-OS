# ============================================================================
# Life OS — Exemplo de variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores.
#   cp .env.example .env   (Linux/macOS)   |   copy .env.example .env  (Windows)
# O arquivo `.env` é ignorado pelo git (.gitignore) — nunca commite segredos.
# ============================================================================

# --- BANCO DE DADOS ---
# MODO LOCAL (desktop/local-first): SQLite em arquivo. A pasta é escolhida no
# wizard de /setup; este valor serve de fallback para o Prisma CLI.
# Windows: use barras normais. Ex: "file:C:/LifeOS_Data/life_os.db"
DATABASE_URL="file:./prisma/life_os.db"
#
# MODO NUVEM (deploy serverless, ex.: Vercel): banco Turso (libSQL).
# Tem PRIORIDADE sobre o config local quando definido. Crie um banco grátis em
# https://turso.tech e gere um token (`turso db tokens create <nome>`).
# TURSO_DATABASE_URL="libsql://seu-banco.turso.io"
# TURSO_AUTH_TOKEN="eyJhbGciOi..."

# --- SEGURANÇA ---
# Segredo de assinatura dos JWT de sessão. Use um valor longo e aleatório.
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Opcional no modo desktop/local: se ausente, o app gera e persiste um segredo
# forte automaticamente em `life-os-config.json` na 1ª execução.
# Em deploy de servidor (Vercel etc.) defina explicitamente para sessões estáveis.
JWT_SECRET="sua_chave_secreta_aqui"
# Chave de criptografia do Cofre de Acessos (mesma regra do JWT_SECRET).
ENCRYPTION_KEY="sua_chave_de_criptografia_aqui"

# --- SEO / DEPLOY ---
# Domínio canônico do site em produção (sem barra no fim). Alimenta as tags
# Open Graph/Twitter, o sitemap.xml e o robots.txt (via config/site.config.ts).
# Se ausente, usa o fallback "https://life-os.vercel.app". Defina com seu domínio
# real no deploy para que links compartilhados e buscadores apontem certo.
# NEXT_PUBLIC_SITE_URL="https://seudominio.com"

# ============================================================================
# MARCA / LOJA (template reutilizável)
# ----------------------------------------------------------------------------
# O conteúdo editável da marca (nome, logo, contato, redes, SEO) NÃO fica aqui:
# fica versionado em  ->  config/site.config.ts
# Os produtos e categorias da loja ficam em  ->  config/catalog.ts
# Guia completo de rebranding e deploy:  ->  md/STORE_SETUP.md
# Aqui só entram SEGREDOS e valores por ambiente.
# ============================================================================

# --- PAGAMENTOS (opcional — só quando integrar o checkout da loja) ---
# Preencha conforme o provedor escolhido com o cliente. Deixe em branco até lá.
# Stripe -> https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# Mercado Pago -> https://www.mercadopago.com.br/developers
# MERCADOPAGO_ACCESS_TOKEN=""
# NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""

# ============================================================================
# INTEGRAÇÕES (opcionais — também podem ser configuradas pela UI em Settings)
# ============================================================================

# Filmes/Séries -> https://www.themoviedb.org/settings/api
TMDB_API_KEY=""

# Jogos -> https://rawg.io/apidocs
RAWG_API_KEY=""

# Open Banking -> https://www.pluggy.ai
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""

# --- Inteligência Artificial (opcionais) ---
# OpenAI -> https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# Groq -> https://console.groq.com/keys
GROQ_API_KEY=""
# Google Gemini -> https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=""
